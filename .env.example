# PräzisAuto Brain — Variáveis de ambiente necessárias
#
# NUNCA commitar o arquivo .env real. Configure estas variáveis:
# - No Claude Code web: nas configurações do ambiente (Environment > Environment variables)
# - Localmente: copie este arquivo para .env e preencha

# ── TinyERP ──────────────────────────────────────────────
# API v2 (token simples): https://tiny.com.br/api-docs
TINY_API_TOKEN=

# API v3 (OAuth2, opcional — se usar a v3 em vez da v2)
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=

# ── Mercado Livre ────────────────────────────────────────
# Criar aplicação em: https://developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Refresh token obtido no fluxo OAuth (authorization code)
ML_REFRESH_TOKEN=
# ID do vendedor (user_id da conta PräzisAuto)
ML_SELLER_ID=
